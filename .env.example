# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI Base URL (for proxy or alternative endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000

# Whisper Model Configuration (Optional)
# Options: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base

# Minio Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=videots
MINIO_SECRET_KEY=videots12345678
MINIO_BUCKET=yvap
MINIO_REGION=us-east-1        # 如需要
MINIO_SECURE=false            # 若走 HTTP
MINIO_PREFIX=videos          # 可选

# delete local temp files
CLEAN_TEMP_FILES=true